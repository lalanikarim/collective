# Collective app on the engram kernel. Core variables below mirror engram's
# .env.example (the kernel reads them); the BOARD_* section is Collective-specific.

# Model catalog (see engram src/model.ts and docs/plans/model-catalog.md).
PI_AGENT_DIR=
DEFAULT_MODEL=

# Legacy env-driven OpenAI-compatible endpoint (Unsloth on Aurora).
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=local
# Optional inference-host identity: PI_PROVIDER_ID — provider id registered with pi-ai (default "aurora")
PI_PROVIDER_ID=

# API server
API_TOKEN=change-me
HOST=127.0.0.1
PORT=8791

# Directories (defaults are relative to the collective app dir)
DATA_DIR=./data
WORK_ROOT=./work
KB_DIR=./kb
CONFIG_DIR=.

# Approval gating (engram gates.json declares risk tiers per tool).
GATED_TOOLS=send_message
APPROVAL_TTL_HOURS=24

# Podman sandbox for code-gen/test conversations.
SANDBOX_IMAGE=docker.io/library/python:3.12-alpine
SANDBOX_NETWORK=none
SANDBOX_ALLOW_IMAGES=docker.io/library/python:3.12-alpine
SANDBOX_ALLOW_MOUNT_ROOT=

# Compaction sizing (reserveTokens must exceed pi-ai's 4096-token safety margin)
RESERVE_TOKENS=16384
KEEP_RECENT_TOKENS=8192
BACKGROUND_TOKENS=8192

# Telegram client (optional — enabled when TELEGRAM_BOT_TOKEN is set).
# Note: for a Collective member instance, outbound comms are disabled by default —
# only the coordinator/owner instance should run its own bot unless selectively enabled.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
TELEGRAM_API_BASE=

# ---- Board (this instance is the board owner) -----------------------------------------
# M2 remote members (engram docs/plans/m2-remote-members.md): tokens for peer instances this
# board owns routing to. Comma-separated name:token pairs; a remote member's profile stores
# only the NAME (tokenRef), never the token itself. The owner's own API_TOKEN acts as the
# "coordinator" identity on the board RPC surface.
BOARD_PEER_TOKENS=

# ---- Board client (this instance is a REMOTE MEMBER of another instance's board) -----
# M2.2 — set on a remote member instance that participates in another instance's board:
#   BOARD_OWNER_URL  base URL of the board-owner instance
#   BOARD_MEMBER_ID  this instance's member id on the owner's board (a name in the owner's
#                    BOARD_PEER_TOKENS; the token comes from this instance's own entry)
BOARD_OWNER_URL=
BOARD_MEMBER_ID=
